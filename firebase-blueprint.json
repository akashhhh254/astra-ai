{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and preferences in Astra AI",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Authentication User ID"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "photoUrl": {
          "type": "string",
          "description": "User avatar photo URL"
        },
        "bio": {
          "type": "string",
          "description": "User brief bio or tagline"
        },
        "authProvider": {
          "type": "string",
          "description": "Auth provider (e.g. google.com)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document update server timestamp"
        }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat session with Astra AI assistant",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of user owning the conversation"
        },
        "title": {
          "type": "string",
          "description": "Conversation title"
        },
        "modelUsed": {
          "type": "string",
          "description": "Gemini model used"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "title", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message in a conversation",
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "description": "Parent conversation ID"
        },
        "userId": {
          "type": "string",
          "description": "User ID"
        },
        "role": {
          "type": "string",
          "description": "Role: user or model"
        },
        "content": {
          "type": "string",
          "description": "Message text content"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Message timestamp"
        }
      },
      "required": ["conversationId", "userId", "role", "content", "createdAt"]
    },
    "GeneratedContent": {
      "title": "GeneratedContent",
      "description": "Saved AI creation such as image, document summary, code, or article",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "contentType": {
          "type": "string",
          "description": "Type of content: image, writing, resume, summary, code, scan"
        },
        "title": {
          "type": "string",
          "description": "Title or label for the creation"
        },
        "content": {
          "type": "string",
          "description": "Generated content text or resource reference"
        },
        "prompt": {
          "type": "string",
          "description": "Original input prompt"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["userId", "contentType", "title", "content", "createdAt"]
    },
    "UsageStat": {
      "title": "UsageStat",
      "description": "User usage telemetry and counters",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "totalRequests": {
          "type": "integer",
          "description": "Total AI request count"
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last activity timestamp"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record creation timestamp"
        }
      },
      "required": ["userId", "totalRequests", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles partitioned by user ID"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Conversations scoped by userId field"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages scoped by conversationId and userId field"
    },
    "/generated_content/{contentId}": {
      "schema": "GeneratedContent",
      "description": "Saved generation records scoped by userId field"
    },
    "/usage_stats/{statId}": {
      "schema": "UsageStat",
      "description": "Usage records scoped by userId field"
    }
  }
}
