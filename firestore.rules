rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. UserProfile Validation
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             (!('uid' in data) || (data.uid is string && data.uid == request.auth.uid)) &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 500)) &&
             (!('authProvider' in data) || (data.authProvider is string && data.authProvider.size() <= 50)) &&
             (!('provider' in data) || (data.provider is string && data.provider.size() <= 50)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('lastLoginAt' in data) || data.lastLoginAt == null || (data.lastLoginAt is timestamp && data.lastLoginAt <= request.time)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // 2. Conversation Validation
    function isValidConversation(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() <= 100)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // 3. Message Validation
    function isValidMessage(data) {
      return data.conversationId is string && isValidId(data.conversationId) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.role is string && (data.role == 'user' || data.role == 'model') &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 50000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 4. GeneratedContent Validation
    function isValidGeneratedContent(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.contentType is string && data.contentType.size() > 0 && data.contentType.size() <= 50 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 100000 &&
             (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 5000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 5. UsageStat Validation
    function isValidUsageStat(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.totalRequests is int && data.totalRequests >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('lastActiveAt' in data) || (data.lastActiveAt is timestamp && data.lastActiveAt <= request.time));
    }

    // Match /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().keys().hasAll(['userId', 'email', 'createdAt']) &&
                       incoming().keys().hasOnly(['uid', 'userId', 'displayName', 'email', 'photoUrl', 'photoURL', 'bio', 'provider', 'authProvider', 'createdAt', 'lastLoginAt', 'updatedAt']);

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'displayName', 'photoUrl', 'photoURL', 'bio', 'provider', 'authProvider', 'lastLoginAt', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Match /conversations/{conversationId}
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(conversationId) &&
                       isValidConversation(incoming()) &&
                       incoming().keys().hasAll(['userId', 'title', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'modelUsed', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       isValidConversation(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'modelUsed', 'updatedAt']);

      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Match /messages/{messageId}
    match /messages/{messageId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(messageId) &&
                       isValidMessage(incoming()) &&
                       incoming().keys().hasAll(['conversationId', 'userId', 'role', 'content', 'createdAt']) &&
                       incoming().keys().hasOnly(['conversationId', 'userId', 'role', 'content', 'createdAt']);

      allow update: if false; // Messages are immutable once written

      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Match /generated_content/{contentId}
    match /generated_content/{contentId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(contentId) &&
                       isValidGeneratedContent(incoming()) &&
                       incoming().keys().hasAll(['userId', 'contentType', 'title', 'content', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'contentType', 'title', 'content', 'prompt', 'createdAt']);

      allow update: if isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       isValidGeneratedContent(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'prompt']);

      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Match /usage_stats/{statId}
    match /usage_stats/{statId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(statId) &&
                       isValidUsageStat(incoming()) &&
                       incoming().keys().hasAll(['userId', 'totalRequests', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'totalRequests', 'lastActiveAt', 'createdAt']);

      allow update: if isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       isValidUsageStat(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['totalRequests', 'lastActiveAt']);

      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
